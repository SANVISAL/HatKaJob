# LOG SERVICE
LOG_LEVEL=debug

# SERVER CONFIGURATION
# NODE_ENV COULD BE DEVELOPMENT, STAGING, PRODUCTION
# PORT OF SERVER RUNNING
NODE_ENV=xxxx
PORT=4004

# Database Service
MONGODB_URL=xxxx

# API GATEWAY SERVICE
API_GATEWAY=http://localhost:4000

# AWS S3 (company logos / uploads)
AWS_ACCESS_KEY_ID=xxxx
AWS_SECRET_ACCESS_KEY=xxxx
AWS_REGION=xxxx
S3_BUCKET_NAME=xxxx
